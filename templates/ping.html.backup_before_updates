        // Render heatmap view
        function renderHeatmapView() {
            const grid = document.getElementById('heatmapGrid');

            if (results.size === 0) {
                grid.innerHTML = '<div class="empty-state">No results yet</div>';
                return;
            }

            let resultArray = Array.from(results.values());
            if (currentFilter === 'reachable') {
                resultArray = resultArray.filter(r => r.status === 'Reachable');
            } else if (currentFilter === 'unreachable') {
                resultArray = resultArray.filter(r => r.status === 'Unreachable');
            }

            grid.innerHTML = '';

            resultArray.forEach(host => {
                const history = pingHistory.get(host.ip) || [];

                // Group pings into 10-second buckets
                const buckets = groupPingsIntoBuckets(history, 10);

                const row = document.createElement('div');
                row.className = 'heatmap-row';

                // Host label
                const label = document.createElement('div');
                label.className = 'heatmap-host-label';
                label.textContent = host.ip;
                row.appendChild(label);

                // Heatmap cells
                buckets.forEach((bucket, idx) => {
                    const cell = document.createElement('div');
                    cell.className = 'heatmap-cell';

                    if (bucket.count === 0) {
                        cell.classList.add('no-data');
                    } else {
                        const successRate = (bucket.success / bucket.count) * 100;
                        if (successRate === 100) cell.classList.add('rate-100');
                        else if (successRate >= 75) cell.classList.add('rate-75');
                        else if (successRate >= 50) cell.classList.add('rate-50');
                        else if (successRate >= 25) cell.classList.add('rate-25');
                        else cell.classList.add('rate-0');

                        cell.textContent = `${Math.round(successRate)}%`;
                    }

                    cell.title = `Bucket ${idx + 1}: ${bucket.success}/${bucket.count} success`;
                    cell.onclick = () => showHostDetail(host.ip);
                    row.appendChild(cell);
                });

                grid.appendChild(row);
            });
        }

        // Group pings into time buckets
        function groupPingsIntoBuckets(pings, bucketSize) {
            if (pings.length === 0) return Array(10).fill({count: 0, success: 0});

            const buckets = [];
            const totalBuckets = 10;
            const pingsPerBucket = Math.ceil(pings.length / totalBuckets);

            for (let i = 0; i < totalBuckets; i++) {
                const start = i * pingsPerBucket;
                const end = start + pingsPerBucket;
                const bucketPings = pings.slice(start, end);

                buckets.push({
                    count: bucketPings.length,
                    success: bucketPings.filter(p => p.status === 'Reachable').length
                });
            }

            return buckets;
        }

        // Show host detail
        function showHostDetail(ip) {
            selectedHost = ip;
            const host = results.get(ip);
            if (!host) return;

            document.getElementById('modalHostTitle').textContent = `${host.hostname || ip} - Detailed View`;

            // Update stats
            const statsDiv = document.getElementById('modalStats');
            statsDiv.innerHTML = `
                <div class="modal-stat">
                    <div class="modal-stat-label">IP Address</div>
                    <div class="modal-stat-value">${host.ip}</div>
                </div>
                <div class="modal-stat">
                    <div class="modal-stat-label">Status</div>
                    <div class="modal-stat-value">${host.status}</div>
                </div>
                <div class="modal-stat">
                    <div class="modal-stat-label">Avg Ping</div>
                    <div class="modal-stat-value">${host.avg_ping_ms ? host.avg_ping_ms.toFixed(1) + 'ms' : 'N/A'}</div>
                </div>
                <div class="modal-stat">
                    <div class="modal-stat-label">Min Ping</div>
                    <div class="modal-stat-value">${host.min_ping_ms ? host.min_ping_ms.toFixed(1) + 'ms' : 'N/A'}</div>
                </div>
                <div class="modal-stat">
                    <div class="modal-stat-label">Max Ping</div>
                    <div class="modal-stat-value">${host.max_ping_ms ? host.max_ping_ms.toFixed(1) + 'ms' : 'N/A'}</div>
                </div>
                <div class="modal-stat">
                    <div class="modal-stat-label">Packet Loss</div>
                    <div class="modal-stat-value">${host.packet_loss_percent.toFixed(0)}%</div>
                </div>
                <div class="modal-stat">
                    <div class="modal-stat-label">TTL</div>
                    <div class="modal-stat-value">${host.ttl || 'N/A'}</div>
                </div>
                <div class="modal-stat">
                    <div class="modal-stat-label">Total Pings</div>
                    <div class="modal-stat-value">${pingHistory.get(ip)?.length || 0}</div>
                </div>
            `;

            // Reset filter
            hostPingFilter = 'all';
            document.querySelectorAll('.modal-body .filter-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.modal-body .filter-btn')[0].classList.add('active');

            renderHostPingHistory();

            document.getElementById('hostModal').classList.add('show');
        }

        // Filter host pings
        function filterHostPings(filter) {
            hostPingFilter = filter;

            // Update button states
            const buttons = document.querySelectorAll('.modal-body .filter-btn');
            buttons.forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');

            renderHostPingHistory();
        }

        // Render host ping history
        function renderHostPingHistory() {
            const history = pingHistory.get(selectedHost) || [];
            const historyDiv = document.getElementById('pingHistory');

            let filteredHistory = history;
            if (hostPingFilter === 'success') {
                filteredHistory = history.filter(p => p.status === 'Reachable');
            } else if (hostPingFilter === 'failed') {
                filteredHistory = history.filter(p => p.status !== 'Reachable');
            }

            if (filteredHistory.length === 0) {
                historyDiv.innerHTML = '<div class="empty-state">No pings match the filter</div>';
                return;
            }

            // Show most recent first
            const reversed = [...filteredHistory].reverse();

            historyDiv.innerHTML = reversed.map(ping => {
                const rttClass = ping.status === 'Reachable' ? '' : 'failed';
                const rttText = ping.status === 'Reachable' ? `${ping.rtt.toFixed(1)}ms` : 'FAILED';

                return `
                    <div class="ping-item">
                        <div class="ping-item-time">${ping.timestamp.toLocaleTimeString()}</div>
                        <div class="ping-item-result">
                            <span class="status-badge ${ping.status === 'Reachable' ? 'status-reachable' : 'status-unreachable'}">${ping.status}</span>
                            <span class="ping-item-rtt ${rttClass}">${rttText}</span>
                            <span style="font-size: 12px; color: #94a3b8;">${ping.packets_sent}/${ping.packets_received} pkts</span>
                            <span style="font-size: 12px; color: #94a3b8;">Loss: ${ping.packet_loss.toFixed(0)}%</span>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // Close host detail
        function closeHostDetail() {
            document.getElementById('hostModal').classList.remove('show');
            selectedHost = null;
        }

        // Update statistics
        function updateStatistics() {
            const total = results.size;
            const reachable = Array.from(results.values()).filter(r => r.status === 'Reachable').length;
            const unreachable = total - reachable;
            const percent = total > 0 ? ((reachable / total) * 100).toFixed(1) : 0;

            const reachableHosts = Array.from(results.values()).filter(r => r.status === 'Reachable' && r.avg_ping_ms !== null);
            const avgPing = reachableHosts.length > 0
                ? (reachableHosts.reduce((sum, r) => sum + r.avg_ping_ms, 0) / reachableHosts.length).toFixed(1)
                : 0;

            document.getElementById('statTotal').textContent = total;
            document.getElementById('statReachable').textContent = reachable;
            document.getElementById('statUnreachable').textContent = unreachable;
            document.getElementById('statPercent').textContent = `${percent}%`;
            document.getElementById('statAvgPing').textContent = `${avgPing}ms`;
        }

        // Filter results
        function filterResults(filter) {
            currentFilter = filter;

            document.querySelectorAll('.results-header .filter-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');

            renderCurrentView();
        }

        // Sort table
        function sortTable(column) {
            if (sortColumn === column) {
                sortAscending = !sortAscending;
            } else {
                sortColumn = column;
                sortAscending = true;
            }
            renderTableView();
        }

        // Clear results
        function clearResults() {
            if (isMonitoring) {
                showNotification('Stop monitoring first', 'error');
                return;
            }
            results.clear();
            pingHistory.clear();
            renderCurrentView();
            updateStatistics();
            document.getElementById('statsSection').style.display = 'none';
        }

        // Export to CSV
        function exportCSV() {
            if (results.size === 0) {
                showNotification('No results to export', 'error');
                return;
            }

            const headers = ['IP Address', 'Hostname', 'Status', 'Avg Ping (ms)', 'Min Ping (ms)', 'Max Ping (ms)', 'Packets Sent', 'Packets Received', 'Loss %', 'TTL', 'Last Update'];
            const rows = Array.from(results.values()).map(r => [
                r.ip,
                r.hostname || 'N/A',
                r.status,
                r.avg_ping_ms !== null ? r.avg_ping_ms.toFixed(1) : 'N/A',
                r.min_ping_ms !== null ? r.min_ping_ms.toFixed(1) : 'N/A',
                r.max_ping_ms !== null ? r.max_ping_ms.toFixed(1) : 'N/A',
                r.packets_sent,
                r.packets_received,
                r.packet_loss_percent.toFixed(0),
                r.ttl || 'N/A',
                new Date(r.last_update).toLocaleString()
            ]);

            const csv = [headers, ...rows].map(row => row.join(',')).join('\n');
            const blob = new Blob([csv], { type: 'text/csv' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `ping_results_${new Date().toISOString().slice(0, 10)}.csv`;
            a.click();
            window.URL.revokeObjectURL(url);

            showNotification('CSV exported successfully', 'success');
        }

        // Show notification
        function showNotification(message, type = 'info') {
            const notification = document.getElementById('notification');
            notification.textContent = message;
            notification.className = `notification ${type} show`;

            setTimeout(() => {
                notification.classList.remove('show');
            }, 3000);
        }
    </script>
