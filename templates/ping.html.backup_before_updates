    <!-- Socket.IO -->
    <script src="https://cdn.socket.io/4.5.4/socket.io.min.js"></script>

    <script>
        // Global state
        let socket = null;
        let results = new Map();
        let pingHistory = new Map(); // Store all individual pings per host
        let currentFilter = 'all';
        let currentView = 'table';
        let sortColumn = 'ip';
        let sortAscending = true;
        let isMonitoring = false;
        let currentRound = 0;
        let maxRounds = 0;
        let selectedHost = null;
        let hostPingFilter = 'all';

        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            connectWebSocket();
            checkStatus();
        });

        // Toggle advanced options
        function toggleAdvancedOptions() {
            const toggle = document.querySelector('.advanced-toggle');
            const options = document.getElementById('advancedOptions');
            toggle.classList.toggle('open');
            options.classList.toggle('open');
        }

        // Toggle monitoring mode
        function toggleMonitoringMode() {
            const mode = document.getElementById('monitoringMode').value;
            const roundsControl = document.getElementById('roundsControl');

            if (mode === 'rounds') {
                roundsControl.style.display = 'flex';
            } else {
                roundsControl.style.display = 'none';
            }
        }

        // WebSocket Connection
        function connectWebSocket() {
            socket = io();

            socket.on('connect', () => {
                console.log('WebSocket connected');
            });

            socket.on('disconnect', () => {
                console.log('WebSocket disconnected');
                showNotification('Disconnected from server', 'error');
            });

            socket.on('ping_result', (data) => {
                updateResult(data);
            });

            socket.on('ping_started', (data) => {
                showNotification(`Monitoring ${data.total} hosts`, 'info');
            });

            socket.on('ping_complete', () => {
                currentRound++;

                const mode = document.getElementById('monitoringMode').value;
                if (mode === 'rounds' && currentRound >= maxRounds) {
                    isMonitoring = false;
                    updateButtons();
                    showNotification(`Completed ${maxRounds} rounds`, 'success');
                } else if (mode === 'continuous') {
                    // Keep monitoring
                } else {
                    isMonitoring = false;
                    updateButtons();
                    showNotification('Ping complete', 'success');
                }
            });

            socket.on('ping_stopped', () => {
                isMonitoring = false;
                updateButtons();
                showNotification('Monitoring stopped', 'info');
            });

            socket.on('error', (data) => {
                showNotification(data.message, 'error');
            });
        }

        // Check admin status
        async function checkStatus() {
            try {
                const response = await fetch('/api/status');
                const data = await response.json();

                const statusDot = document.getElementById('statusDot');
                const statusText = document.getElementById('statusText');

                if (data.is_admin) {
                    statusDot.classList.remove('not-admin');
                    statusDot.classList.add('admin');
                    statusText.textContent = 'ADMINISTRATOR';
                } else {
                    statusDot.classList.remove('admin');
                    statusDot.classList.add('not-admin');
                    statusText.textContent = 'NOT ADMIN';
                }
            } catch (error) {
                console.error('Error checking status:', error);
                document.getElementById('statusText').textContent = 'ERROR';
            }
        }

        // Start ping
        function startPing() {
            const input = document.getElementById('ipInput').value.trim();
            if (!input) {
                showNotification('Please enter at least one IP address', 'error');
                return;
            }

            const pingCount = parseInt(document.getElementById('pingCount').value);
            const timeout = parseInt(document.getElementById('timeout').value);
            const interval = parseInt(document.getElementById('interval').value);
            const mode = document.getElementById('monitoringMode').value;
            const rounds = mode === 'rounds' ? parseInt(document.getElementById('rounds').value) : 0;

            const continuous = (mode === 'continuous');

            currentRound = 0;
            maxRounds = rounds;

            socket.emit('start_ping', {
                input: input,
                ping_count: pingCount,
                timeout: timeout,
                continuous: continuous,
                interval: interval
            });

            isMonitoring = true;
            updateButtons();
            document.getElementById('statsSection').style.display = 'block';
        }

        // Stop ping
        function stopPing() {
            socket.emit('stop_ping');
        }

        // Update buttons
        function updateButtons() {
            document.getElementById('startBtn').style.display = isMonitoring ? 'none' : 'inline-flex';
            document.getElementById('stopBtn').style.display = isMonitoring ? 'inline-flex' : 'none';
        }

        // Update result
        function updateResult(data) {
            results.set(data.ip, data);

            // Store ping history
            if (!pingHistory.has(data.ip)) {
                pingHistory.set(data.ip, []);
            }

            // Add this ping to history
            pingHistory.get(data.ip).push({
                timestamp: new Date(data.last_update),
                status: data.status,
                rtt: data.avg_ping_ms,
                packets_sent: data.packets_sent,
                packets_received: data.packets_received,
                packet_loss: data.packet_loss_percent,
                ttl: data.ttl
            });

            // Keep only last 100 pings per host
            if (pingHistory.get(data.ip).length > 100) {
                pingHistory.get(data.ip).shift();
            }

            renderCurrentView();
            updateStatistics();
        }

        // Switch view
        function switchView(view) {
            currentView = view;

            // Update view buttons
            document.querySelectorAll('.view-btn').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');

            // Hide all views
            document.getElementById('tableView').style.display = 'none';
            document.getElementById('timelineView').style.display = 'none';
            document.getElementById('heatmapView').style.display = 'none';

            // Show selected view
            if (view === 'table') {
                document.getElementById('tableView').style.display = 'block';
            } else if (view === 'timeline') {
                document.getElementById('timelineView').style.display = 'block';
            } else if (view === 'heatmap') {
                document.getElementById('heatmapView').style.display = 'block';
            }

            renderCurrentView();
        }

        // Render current view
        function renderCurrentView() {
            if (currentView === 'table') {
                renderTableView();
            } else if (currentView === 'timeline') {
                renderTimelineView();
            } else if (currentView === 'heatmap') {
                renderHeatmapView();
            }
        }

        // Render table view
        function renderTableView() {
            const tbody = document.getElementById('resultsBody');

            if (results.size === 0) {
                tbody.innerHTML = '<tr><td colspan="8"><div class="empty-state">No results yet</div></td></tr>';
                return;
            }

            let resultArray = Array.from(results.values());

            if (currentFilter === 'reachable') {
                resultArray = resultArray.filter(r => r.status === 'Reachable');
            } else if (currentFilter === 'unreachable') {
                resultArray = resultArray.filter(r => r.status === 'Unreachable');
            }

            resultArray.sort((a, b) => {
                let aVal = a[sortColumn] || '';
                let bVal = b[sortColumn] || '';

                if (sortColumn === 'ping') {
                    aVal = a.avg_ping_ms || 9999;
                    bVal = b.avg_ping_ms || 9999;
                } else if (sortColumn === 'loss') {
                    aVal = a.packet_loss_percent || 0;
                    bVal = b.packet_loss_percent || 0;
                }

                if (sortAscending) {
                    return aVal > bVal ? 1 : -1;
                } else {
                    return aVal < bVal ? 1 : -1;
                }
            });

            tbody.innerHTML = resultArray.map(r => {
                const statusClass = r.status === 'Reachable' ? 'status-reachable' :
                                   r.status === 'Unreachable' ? 'status-unreachable' : 'status-testing';

                const avgPing = r.avg_ping_ms !== null ? r.avg_ping_ms.toFixed(1) : 'N/A';
                const lastUpdate = new Date(r.last_update).toLocaleTimeString();

                return `
                    <tr onclick="showHostDetail('${r.ip}')">
                        <td>${r.ip}</td>
                        <td>${r.hostname || 'N/A'}</td>
                        <td><span class="status-badge ${statusClass}">${r.status}</span></td>
                        <td>${avgPing}</td>
                        <td>${r.packets_sent}/${r.packets_received}</td>
                        <td>${r.packet_loss_percent.toFixed(0)}%</td>
                        <td>${r.ttl || 'N/A'}</td>
                        <td>${lastUpdate}</td>
                    </tr>
                `;
            }).join('');
        }

        // Render timeline view
        function renderTimelineView() {
            const grid = document.getElementById('timelineGrid');
            const labels = document.getElementById('timelineLabels');

            if (results.size === 0) {
                grid.innerHTML = '<div class="empty-state">No results yet</div>';
                labels.innerHTML = '';
                return;
            }

            let resultArray = Array.from(results.values());
            if (currentFilter === 'reachable') {
                resultArray = resultArray.filter(r => r.status === 'Reachable');
            } else if (currentFilter === 'unreachable') {
                resultArray = resultArray.filter(r => r.status === 'Unreachable');
            }

            // Generate time labels (last 30 pings)
            const maxPings = 30;
            labels.innerHTML = '';
            for (let i = 0; i < maxPings; i++) {
                const label = document.createElement('div');
                label.className = 'timeline-time-label';
                label.textContent = i === 0 ? 'Now' : `-${i}`;
                labels.appendChild(label);
            }

            // Render timeline for each host
            grid.innerHTML = '';
            resultArray.forEach(host => {
                const history = pingHistory.get(host.ip) || [];
                const recentPings = history.slice(-maxPings);

                // Host label
                const labelDiv = document.createElement('div');
                labelDiv.className = 'timeline-host-label';
                labelDiv.textContent = host.ip;
                grid.appendChild(labelDiv);

                // Timeline row
                const rowDiv = document.createElement('div');
                rowDiv.className = 'timeline-row';

                // Pad with empty cells if needed
                const padding = maxPings - recentPings.length;
                for (let i = 0; i < padding; i++) {
                    const cell = document.createElement('div');
                    cell.className = 'timeline-cell no-data';
                    rowDiv.appendChild(cell);
                }

                // Add ping cells
                recentPings.forEach((ping, idx) => {
                    const cell = document.createElement('div');
                    cell.className = `timeline-cell ${ping.status === 'Reachable' ? 'success' : 'failed'}`;
                    cell.title = `${ping.timestamp.toLocaleTimeString()} - ${ping.status} - ${ping.rtt ? ping.rtt.toFixed(1) + 'ms' : 'N/A'}`;
                    cell.onclick = () => showHostDetail(host.ip);
                    rowDiv.appendChild(cell);
                });

                grid.appendChild(rowDiv);
            });

            // Detect outages (multiple hosts failing at same time)
            detectOutages();
        }

        // Detect outages
        function detectOutages() {
