        // ===== MTU PATH DISCOVERY =====
        function startMTUDiscovery() {
            if (mtuRunning) {
                showNotification('MTU discovery already running', 'warning');
                return;
            }

            const target = document.getElementById('mtuTarget').value.trim();
            if (!target) {
                showNotification('Please enter a target host or IP', 'error');
                return;
            }

            mtuRunning = true;
            mtuResults = [];

            const btn = document.getElementById('mtuBtn');
            btn.disabled = true;
            btn.innerHTML = '<svg class="icon spin" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg><span>Discovering...</span>';

            document.getElementById('mtuProgress').style.display = 'block';
            document.getElementById('mtuProgressText').textContent = 'Starting discovery...';
            document.getElementById('mtuDisplay').innerHTML = '<div class="empty-state">Discovering path to ' + target + '...</div>';

            socket.emit('start_mtu_discovery', { target: target });
        }

        socket.on('mtu_hop_result', (result) => {
            console.log('MTU hop result:', result);
            mtuResults.push(result);
            updateMTUDisplay();
        });

        socket.on('mtu_discovery_complete', (results) => {
            console.log('MTU discovery complete:', results);
            mtuRunning = false;

            const btn = document.getElementById('mtuBtn');
            btn.disabled = false;
            btn.innerHTML = '<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg><span>Start Discovery</span>';

            document.getElementById('mtuProgress').style.display = 'none';
            document.getElementById('mtuProgressText').textContent = '';

            showNotification(`MTU Discovery complete! Found ${results.length} hops`, 'success');
        });

        socket.on('mtu_discovery_error', (error) => {
            console.error('MTU discovery error:', error);
            mtuRunning = false;

            const btn = document.getElementById('mtuBtn');
            btn.disabled = false;
            btn.innerHTML = '<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg><span>Start Discovery</span>';

            document.getElementById('mtuProgress').style.display = 'none';
            document.getElementById('mtuDisplay').innerHTML = '<div class="empty-state">Error: ' + error + '</div>';

            showNotification('MTU Discovery failed: ' + error, 'error');
        });

        socket.on('mtu_discovery_status', (status) => {
            document.getElementById('mtuProgressText').textContent = status.message || 'Working...';
        });

        function updateMTUDisplay() {
            const display = document.getElementById('mtuDisplay');

            if (mtuResults.length === 0) {
                display.innerHTML = '<div class="empty-state">No results yet...</div>';
                return;
            }

            let html = '<table style="width: 100%; border-collapse: collapse; margin-top: 16px;">';
            html += '<thead><tr style="background: rgba(59, 130, 246, 0.1); border-bottom: 2px solid rgba(59, 130, 246, 0.3);">';
            html += '<th style="padding: 12px; text-align: left;">Hop</th>';
            html += '<th style="padding: 12px; text-align: left;">IP Address</th>';
            html += '<th style="padding: 12px; text-align: left;">Hostname</th>';
            html += '<th style="padding: 12px; text-align: left;">Path MTU</th>';
            html += '<th style="padding: 12px; text-align: left;">Capacity</th>';
            html += '<th style="padding: 12px; text-align: left;">Status</th>';
            html += '</tr></thead><tbody>';

            mtuResults.forEach(result => {
                const statusColor = result.pathMtu >= 1500 ? '#10b981' : (result.pathMtu > 0 ? '#f59e0b' : '#ef4444');
                const status = result.pathMtu >= 1500 ? 'Optimal' : (result.pathMtu > 0 ? 'Reduced' : 'Unreachable');

                html += '<tr style="border-bottom: 1px solid rgba(148, 163, 184, 0.1);">';
                html += `<td style="padding: 12px;"><strong>#${result.hop}</strong></td>`;
                html += `<td style="padding: 12px;">${result.ip}</td>`;
                html += `<td style="padding: 12px;">${result.hostname || result.ip}</td>`;
                html += `<td style="padding: 12px;">${result.pathMtu} bytes</td>`;
                html += `<td style="padding: 12px;">${result.hopCapacity} bytes</td>`;
                html += `<td style="padding: 12px; color: ${statusColor}; font-weight: 600;">${status}</td>`;
                html += '</tr>';
            });

            html += '</tbody></table>';
            display.innerHTML = html;
        }
    </script>
</body>
</html>
