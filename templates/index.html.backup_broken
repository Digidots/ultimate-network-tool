        // ===== ADD VLAN RESULT =====
        function addVLANResult(result) {
            // Only add VLANs with status 'Active' or 'Detected'
            if (result.status === 'Active' || result.status === 'Detected') {
                // Add ALL active/detected VLANs regardless of DHCP info
                // This includes:
                // 1. VLANs with DHCP response (have IP range, gateway, etc.)
                // 2. VLANs detected via passive listening (no DHCP info but confirmed present)
                // 3. Native/Untagged VLANs

                if (result.source === 'Native/Untagged' && !nativeVLAN) {
                    nativeVLAN = result;
                } else {
                    discoveredVLANs.set(result.vlan_id, result);
                }
                updateVLANDisplay();
            }
        }

        // ===== UPDATE VLAN DISPLAY (NEW WITH TAGGED/UNTAGGED) =====
        function updateVLANDisplay() {
            const container = document.getElementById('vlanDisplay');
            container.innerHTML = '';

            if (!nativeVLAN && discoveredVLANs.size === 0) {
                container.innerHTML = '<div class="empty-state">No VLANs detected yet...</div>';
                return;
            }

            // Show UNTAGGED VLAN first (if exists)
            if (nativeVLAN) {
                const vlanRow = document.createElement('div');
                vlanRow.className = 'vlan-row untagged';
                vlanRow.innerHTML = `
                    <div class="vlan-row-id">VLAN ${nativeVLAN.vlan_id}</div>
                    <div class="vlan-type-badge">UNTAGGED</div>
                    <div class="vlan-row-data">
                        <div class="vlan-row-item">
                            <span class="vlan-row-label">Source:</span>
                            <span class="vlan-row-value">${nativeVLAN.source}</span>
                        </div>
                    </div>
