                    const result = discoveredVLANs.get(vlanId);
                    const vlanRow = document.createElement('div');
                    vlanRow.className = 'vlan-row tagged';

                    // Build VLAN row HTML with conditional DHCP fields
                    // Show VLAN name if available (from LLDP)
                    let vlanHeader = `VLAN ${vlanId}`;
                    if (result.vlan_name && result.vlan_name !== 'N/A') {
                        vlanHeader += ` <span style="font-size: 0.85em; font-weight: normal; color: #999;">(${result.vlan_name})</span>`;
                    }

                    let rowHTML = `
                        <div class="vlan-row-id">${vlanHeader}</div>
                        <div class="vlan-type-badge">TAGGED</div>
                        <div class="vlan-row-data">
                            <div class="vlan-row-item">
                                <span class="vlan-row-label">IP Range:</span>
                                <span class="vlan-row-value">${result.ip_range || 'N/A'}</span>
                            </div>
                            <span class="vlan-row-separator">|</span>
                            <div class="vlan-row-item">
                                <span class="vlan-row-label">Subnet:</span>
                                <span class="vlan-row-value">${result.subnet_mask || 'N/A'}</span>
                            </div>
                            <span class="vlan-row-separator">|</span>
                            <div class="vlan-row-item">
                                <span class="vlan-row-label">Gateway:</span>
                                <span class="vlan-row-value">${result.gateway || 'N/A'}</span>
                            </div>
                            <span class="vlan-row-separator">|</span>
                            <div class="vlan-row-item">
                                <span class="vlan-row-label">DHCP:</span>
                                <span class="vlan-row-value">${result.dhcp_server || 'N/A'}</span>
                            </div>`;

                    // Add lease time if available
                    if (result.lease_time) {
                        rowHTML += `
                            <span class="vlan-row-separator">|</span>
                            <div class="vlan-row-item">
                                <span class="vlan-row-label">Lease:</span>
                                <span class="vlan-row-value">${formatLeaseTime(result.lease_time)}</span>
                            </div>`;
                    }

                    // Add vendor class if available (Option 60)
                    if (result.vendor_class) {
                        rowHTML += `
                            <span class="vlan-row-separator">|</span>
                            <div class="vlan-row-item">
                                <span class="vlan-row-label">Vendor:</span>
                                <span class="vlan-row-value" title="${result.vendor_class}">${result.vendor_class.substring(0, 20)}${result.vendor_class.length > 20 ? '...' : ''}</span>
                            </div>`;
                    }

                    // Add TFTP server if available (Option 66)
                    if (result.tftp_server) {
                        rowHTML += `
                            <span class="vlan-row-separator">|</span>
                            <div class="vlan-row-item">
                                <span class="vlan-row-label">TFTP:</span>
                                <span class="vlan-row-value">${result.tftp_server}</span>
                            </div>`;
                    }

                    rowHTML += `
                            <span class="vlan-row-separator">|</span>
                            <div class="vlan-row-item">
                                <span class="vlan-row-label">Source:</span>
                                <span class="vlan-row-value">${result.source}</span>
                            </div>`;

                    // Collect ALL DHCP options for comprehensive display
                    let allOptions = [];

                    // Main options (always show if available)
                    if (result.subnet_mask && result.subnet_mask !== 'N/A') {
                        allOptions.push({num: 1, name: 'Subnet Mask', value: result.subnet_mask, priority: true});
                    }
                    if (result.gateway && result.gateway !== 'N/A') {
                        allOptions.push({num: 3, name: 'Router/Gateway', value: result.gateway, priority: true});
                    }
                    if (result.dhcp_server && result.dhcp_server !== 'N/A') {
                        allOptions.push({num: 54, name: 'DHCP Server', value: result.dhcp_server, priority: true});
                    }

                    // Additional options
                    if (result.domain_name) {
                        allOptions.push({num: 15, name: 'Domain', value: result.domain_name, priority: false});
                    }
                    if (result.broadcast_address) {
                        allOptions.push({num: 28, name: 'Broadcast', value: result.broadcast_address, priority: false});
                    }
                    if (result.vendor_specific) {
                        allOptions.push({num: 43, name: 'Vendor-Specific', value: result.vendor_specific, priority: false});
                    }
                    if (result.lease_time) {
                        allOptions.push({num: 51, name: 'Lease Time', value: formatLeaseTime(result.lease_time), priority: false});
