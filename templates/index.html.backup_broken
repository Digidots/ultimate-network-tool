    <script>
        // ===== GLOBAL STATE =====
        let socket = null;
        let discoveryRunning = false;
        let vlanRunning = false;
        let mtuRunning = false;
        let adapters = [];
        let selectedAdapterIndex = -1;
        let discoveredVLANs = new Map();
        let mtuResults = [];
        let nativeVLAN = null;
        let vlanMode = 'range';
        let totalVLANsToScan = 0;
        let scannedVLANs = 0;

        // ===== HELPER FUNCTIONS =====
        function formatLeaseTime(seconds) {
            if (!seconds) return 'N/A';
            const hours = Math.floor(seconds / 3600);
            const minutes = Math.floor((seconds % 3600) / 60);
            if (hours > 24) {
                const days = Math.floor(hours / 24);
                return `${days}d ${hours % 24}h`;
            } else if (hours > 0) {
                return `${hours}h ${minutes}m`;
            } else {
                return `${minutes}m`;
            }
        }

        // ===== INITIALIZATION =====
        document.addEventListener('DOMContentLoaded', () => {
            connectWebSocket();
            checkStatus();
            loadAdapters();
            setupCopyHandlers();
        });

        // ===== COPY TO CLIPBOARD =====
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                showNotification(`Copied: ${text}`, 'success');
            }).catch(err => {
                console.error('Failed to copy:', err);
            });
        }

        function setupCopyHandlers() {
            document.addEventListener('click', (e) => {
                const copyable = e.target.closest('.info-badge-value, .lldp-badge-value, .vlan-row-value');
                if (copyable) {
                    const text = copyable.textContent.trim();
                    if (text && text !== 'N/A') {
                        copyToClipboard(text);
                    }
                }
            });
        }

        // ===== WEBSOCKET CONNECTION =====
        function connectWebSocket() {
            socket = io();

            socket.on('connect', () => {
                console.log('WebSocket connected');
                showNotification('Connected to server', 'success');
            });

            socket.on('disconnect', () => {
                console.log('WebSocket disconnected');
                showNotification('Disconnected from server', 'error');
            });

            socket.on('error', (data) => {
                showNotification(data.message, 'error');
            });

            socket.on('discovery_started', (data) => {
                showNotification('Discovery started', 'info');
                document.getElementById('discoveryResults').innerHTML = '<div class="empty-state">Listening for LLDP/CDP packets...</div>';
            });

            socket.on('discovery_result', (result) => {
                updateDiscoveryResult(result);
            });

            socket.on('discovery_stopped', () => {
                discoveryRunning = false;
                updateDiscoveryButton();
                showNotification('Discovery stopped', 'info');
            });

            // NEW: Handle VLAN discoveries from LLDP/CDP (Fluke-style!)
            socket.on('vlan_from_lldp', (data) => {
                console.log('LLDP VLAN Discovery:', data);

                // Create a VLAN result from LLDP discovery
                let result = {
                    vlan_id: data.vlan_id,
                    status: 'Active',
                    source: data.source,
                    vlan_name: data.vlan_name || 'N/A',
                    vlan_type: data.type, // 'native' or 'tagged'
                    // No DHCP info for LLDP-discovered VLANs (yet)
                    ip_range: 'N/A',
                    subnet_mask: 'N/A',
                    gateway: 'N/A',
                    dhcp_server: 'N/A',
                    offered_ip: 'N/A',
                    lease_time: null,
                    domain_name: null,
                    broadcast_address: null,
                    vendor_specific: null,
                    vendor_class: null,
                    tftp_server: null
                };

                // Add to VLAN results
                addVLANResult(result);

                // Show notification for first VLAN discovered via LLDP
                if (!window.lldpNotificationShown) {
                    showNotification('VLANs detected from LLDP advertisement', 'success');
                    window.lldpNotificationShown = true;
                }
            });

            socket.on('vlan_probe_started', (data) => {
                showNotification('Scanning VLANs...', 'info');
                document.getElementById('vlanProgress').classList.add('active');
                document.getElementById('vlanProgressText').classList.add('active');
                document.getElementById('vlanProgressBar').style.width = '0%';
                scannedVLANs = 0;
            });

            socket.on('vlan_result', (result) => {
                // Only count Active VLANs (not Timeout) for progress
                if (result.status === 'Active') {
                    scannedVLANs++;
                    if (totalVLANsToScan > 0) {
                        const percent = Math.min((scannedVLANs / totalVLANsToScan) * 100, 100);
                        document.getElementById('vlanProgressBar').style.width = percent + '%';
                        document.getElementById('vlanProgressText').textContent =
                            `Found ${scannedVLANs} active VLANs...`;
                    }
                }
                addVLANResult(result);
            });

            socket.on('vlan_probe_complete', (data) => {
                vlanRunning = false;
                updateVLANButton();
                showNotification(`Scan complete: ${data.total} VLANs found`, 'success');
                document.getElementById('vlanProgress').classList.remove('active');
                document.getElementById('vlanProgressText').classList.remove('active');
            });

            socket.on('vlan_probe_stopped', () => {
                vlanRunning = false;
                updateVLANButton();
                showNotification('VLAN scan stopped', 'info');
                document.getElementById('vlanProgress').classList.remove('active');
                document.getElementById('vlanProgressText').classList.remove('active');
            });
        }

