<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ultimate Network Tool - MTU UPDATED 20:50</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            color: #f1f5f9;
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1600px;
            margin: 0 auto;
        }

        /* ===== HEADER ===== */
        .header {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.15) 0%, rgba(139, 92, 246, 0.1) 100%);
            border: 1px solid rgba(59, 130, 246, 0.3);
            border-radius: 16px;
            padding: 24px 32px;
            margin-bottom: 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
        }

        .title-section {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .brand-text {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        h1 {
            font-size: 28px;
            font-weight: 800;
            letter-spacing: 0.5px;
            background: linear-gradient(135deg, #60a5fa 0%, #c084fc 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-transform: uppercase;
        }

        .tagline {
            font-size: 12px;
            font-weight: 400;
            color: #94a3b8;
            letter-spacing: 0.3px;
        }

        .admin-status {
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(15, 23, 42, 0.8);
            padding: 10px 20px;
            border-radius: 10px;
            border: 1px solid rgba(148, 163, 184, 0.2);
        }

        .status-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            animation: pulse 2s ease-in-out infinite;
        }

        .status-dot.admin {
            background: #10b981;
            box-shadow: 0 0 12px rgba(16, 185, 129, 0.6);
        }

        .status-dot.not-admin {
            background: #ef4444;
            box-shadow: 0 0 12px rgba(239, 68, 68, 0.6);
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.5; transform: scale(0.9); }
        }

        .status-text {
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: #cbd5e1;
        }

        /* ===== BUTTONS (COMPLETELY NEW DESIGN) ===== */
        button {
            font-family: 'Segoe UI', sans-serif;
            font-size: 14px;
            font-weight: 700;
            padding: 14px 28px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-width: 180px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
            position: relative;
            overflow: hidden;
        }

        button:before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            transform: translate(-50%, -50%);
            transition: width 0.6s, height 0.6s;
        }

        button:hover:before {
            width: 300px;
            height: 300px;
        }

        button span {
            position: relative;
            z-index: 1;
            color: white;
        }

        /* Primary Button (Purple) */
        .btn-primary {
            background: linear-gradient(135deg, #a855f7 0%, #9333ea 100%);
            color: white;
        }

        .btn-primary:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 6px 24px rgba(168, 85, 247, 0.5);
        }

        /* Success Button (Green) */
        .btn-success {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
        }

        .btn-success:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 6px 24px rgba(16, 185, 129, 0.5);
        }

        /* Danger Button (Red) */
        .btn-danger {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: white;
        }

        .btn-danger:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 6px 24px rgba(239, 68, 68, 0.5);
        }

        /* Info Button (Blue) */
        .btn-info {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            color: white;
        }

        .btn-info:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 6px 24px rgba(59, 130, 246, 0.5);
        }

        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none !important;
        }

        button:active:not(:disabled) {
            transform: translateY(0);
        }

        /* ===== SVG ICONS ===== */
        .icon {
            width: 20px;
            height: 20px;
            stroke-width: 2;
            display: inline-block;
            vertical-align: middle;
            margin-right: 8px;
        }

        button .icon {
            margin-top: -2px;
        }

        .brand-icon {
            width: 48px;
            height: 48px;
            stroke-width: 1.5;
        }

        /* ===== NOTIFICATION ===== */
        .notification {
            position: fixed;
            top: 24px;
            right: 24px;
            background: rgba(15, 23, 42, 0.98);
            border: 1px solid rgba(148, 163, 184, 0.3);
            border-radius: 12px;
            padding: 16px 20px;
            max-width: 350px;
            z-index: 10000;
            display: none;
            animation: slideIn 0.3s ease;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
            font-size: 14px;
            color: #f1f5f9;
        }

        .notification.show {
            display: block;
        }

        .notification.success { border-left: 4px solid #10b981; }
        .notification.error { border-left: 4px solid #ef4444; }
        .notification.info { border-left: 4px solid #3b82f6; }

        @keyframes slideIn {
            from { transform: translateX(400px); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }

        /* ===== ADAPTER SECTION ===== */
        .adapter-section {
            background: rgba(30, 41, 59, 0.6);
            border: 1px solid rgba(148, 163, 184, 0.2);
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 24px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
        }

        .adapter-controls {
            display: flex;
            gap: 12px;
            align-items: center;
            margin-bottom: 20px;
        }

        label {
            font-size: 12px;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 1px;
            min-width: 140px;
        }

        select {
            flex: 1;
            background: rgba(15, 23, 42, 0.9);
            border: 1px solid rgba(148, 163, 184, 0.3);
            border-radius: 10px;
            padding: 14px 18px;
            color: #f1f5f9;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        select:hover {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        select:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.2);
        }

        .info-badges {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 12px;
        }

        .info-badge {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(139, 92, 246, 0.08) 100%);
            border: 1px solid rgba(59, 130, 246, 0.3);
            border-radius: 10px;
            padding: 14px 18px;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .info-badge:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(59, 130, 246, 0.3);
            border-color: rgba(59, 130, 246, 0.5);
        }

        .info-badge-label {
            font-size: 10px;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 6px;
            font-weight: 700;
        }

        .info-badge-value {
            font-size: 15px;
            font-weight: 700;
            color: #f1f5f9;
            font-family: 'Consolas', monospace;
        }

        .info-badge-value:active {
            color: #10b981;
        }

        /* ===== SECTIONS ===== */
        .section-card {
            background: rgba(30, 41, 59, 0.6);
            border: 1px solid rgba(148, 163, 184, 0.2);
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 24px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .section-title-wrapper {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .section-title {
            font-size: 20px;
            font-weight: 800;
            background: linear-gradient(135deg, #60a5fa 0%, #c084fc 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* ===== INFO ICON (FIXED) ===== */
        .info-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 22px;
            height: 22px;
            background: rgba(255, 255, 255, 0.15);
            border: 2px solid rgba(255, 255, 255, 0.4);
            border-radius: 50%;
            font-size: 14px;
            font-weight: 900;
            color: white;
            cursor: help;
            position: relative;
            transition: all 0.3s ease;
        }

        .info-icon:hover {
            background: rgba(255, 255, 255, 0.25);
            border-color: rgba(255, 255, 255, 0.6);
            transform: scale(1.1);
        }

        .info-icon::after {
            content: attr(data-tooltip);
            position: absolute;
            left: 0;
            bottom: calc(100% + 12px);
            transform: scale(0.8);
            background: rgba(15, 23, 42, 0.98);
            color: #f1f5f9;
            padding: 14px 18px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 500;
            min-width: 400px;
            max-width: 600px;
            width: max-content;
            white-space: normal;
            line-height: 1.6;
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
            opacity: 0;
            pointer-events: none;
            transition: all 0.3s ease;
            z-index: 1000;
        }

        .info-icon:hover::after {
            opacity: 1;
            transform: scale(1);
        }

        .info-icon::before {
            content: '';
            position: absolute;
            left: 20px;
            bottom: calc(100% + 4px);
            border: 8px solid transparent;
            border-top-color: rgba(15, 23, 42, 0.98);
            opacity: 0;
            transition: all 0.3s ease;
            z-index: 999;
        }

        .info-icon:hover::before {
            opacity: 1;
        }

        /* ===== VLAN CONTROLS ===== */
        .vlan-controls {
            display: flex;
            flex-direction: column;
            gap: 14px;
            margin-bottom: 20px;
        }

        .vlan-mode-toggle {
            display: flex;
            gap: 10px;
        }

        .mode-btn {
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            background: rgba(15, 23, 42, 0.8);
            border: 1px solid rgba(148, 163, 184, 0.3);
            color: #94a3b8;
            transition: all 0.3s ease;
            min-width: 120px;
        }

        .mode-btn.active {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            border-color: #3b82f6;
            color: white;
            box-shadow: 0 2px 8px rgba(59, 130, 246, 0.4);
        }

        .vlan-input-row {
            display: flex;
            gap: 12px;
            align-items: center;
        }

        input[type="number"],
        input[type="text"] {
            background: rgba(15, 23, 42, 0.9);
            border: 1px solid rgba(148, 163, 184, 0.3);
            border-radius: 10px;
            padding: 12px 16px;
            color: #f1f5f9;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        input[type="number"] {
            width: 90px;
        }

        input[type="text"] {
            flex: 1;
        }

        input:hover {
            border-color: #3b82f6;
        }

        input:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.2);
        }

        /* ===== PROGRESS BAR ===== */
        .progress-container {
            width: 100%;
            height: 8px;
            background: rgba(15, 23, 42, 0.9);
            border-radius: 4px;
            overflow: hidden;
            display: none;
            margin-top: 12px;
        }

        .progress-container.active {
            display: block;
        }

        .progress-bar {
            height: 100%;
            background: linear-gradient(90deg, #10b981 0%, #34d399 50%, #10b981 100%);
            border-radius: 4px;
            width: 0%;
            transition: width 0.4s ease;
            box-shadow: 0 0 12px rgba(16, 185, 129, 0.6);
            animation: shimmer 2s infinite;
        }

        @keyframes shimmer {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .progress-text {
            font-size: 12px;
            color: #cbd5e1;
            margin-top: 8px;
            text-align: center;
            font-weight: 700;
            display: none;
        }

        .progress-text.active {
            display: block;
        }

        /* ===== LLDP RESULTS ===== */
        .lldp-results {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            min-height: 140px;
            align-content: flex-start;
        }

        .lldp-badge {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.15) 0%, rgba(139, 92, 246, 0.1) 100%);
            border: 1px solid rgba(59, 130, 246, 0.4);
            border-radius: 12px;
            padding: 10px 14px;
            min-width: 180px;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .lldp-badge:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(59, 130, 246, 0.4);
            border-color: rgba(59, 130, 246, 0.6);
        }

        .protocol-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            font-family: 'Segoe UI', sans-serif;
        }

        .protocol-badge.lldp {
            background: rgba(59, 130, 246, 0.2);
            color: #60a5fa !important;
            border: 1px solid rgba(59, 130, 246, 0.5);
        }

        .protocol-badge.cdp {
            background: rgba(245, 158, 11, 0.2);
            color: #fbbf24 !important;
            border: 1px solid rgba(245, 158, 11, 0.5);
        }

        .lldp-badge-label {
            font-size: 10px;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 6px;
            font-weight: 700;
        }

        .lldp-badge-value {
            font-size: 14px;
            font-weight: 700;
            color: #f1f5f9;
            font-family: 'Consolas', monospace;
        }

        /* ===== VLAN DISPLAY (NEW DESIGN) ===== */
        .vlan-display {
            display: flex;
            flex-direction: column;
            gap: 12px;
            min-height: 140px;
        }

        /* UNTAGGED VLAN (Orange/Amber color) */
        .vlan-row.untagged {
            background: linear-gradient(135deg, rgba(245, 158, 11, 0.15) 0%, rgba(217, 119, 6, 0.1) 100%);
            border: 2px solid rgba(245, 158, 11, 0.5);
            box-shadow: 0 0 20px rgba(245, 158, 11, 0.2);
        }

        .vlan-row.untagged:hover {
            border-color: rgba(245, 158, 11, 0.7);
            box-shadow: 0 4px 20px rgba(245, 158, 11, 0.4);
        }

        .vlan-row.untagged .vlan-row-id {
            background: rgba(245, 158, 11, 0.3);
            color: #fbbf24;
            border: 1px solid rgba(245, 158, 11, 0.6);
        }

        .vlan-row.untagged .vlan-type-badge {
            background: rgba(245, 158, 11, 0.3);
            color: #fbbf24;
            border: 1px solid rgba(245, 158, 11, 0.6);
        }

        /* TAGGED VLAN (Green color) */
        .vlan-row.tagged {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(5, 150, 105, 0.08) 100%);
            border: 1px solid rgba(16, 185, 129, 0.4);
        }

        .vlan-row.tagged:hover {
            border-color: rgba(16, 185, 129, 0.6);
            box-shadow: 0 4px 16px rgba(16, 185, 129, 0.3);
        }

        .vlan-row.tagged .vlan-row-id {
            background: rgba(16, 185, 129, 0.2);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.5);
        }

        .vlan-row.tagged .vlan-type-badge {
            background: rgba(16, 185, 129, 0.2);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.5);
        }

        .vlan-row {
            padding: 10px 14px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .vlan-row:hover {
            transform: translateX(6px);
        }

        .vlan-row-id {
            padding: 6px 12px;
            border-radius: 6px;
            font-weight: 900;
            font-size: 12px;
            min-width: 75px;
            text-align: center;
        }

        .vlan-type-badge {
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 10px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            min-width: 85px;
            text-align: center;
        }

        .vlan-row-data {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: nowrap;
            font-size: 11px;
            font-family: 'Consolas', monospace;
        }

        .vlan-row-item {
            display: flex;
            gap: 4px;
            white-space: nowrap;
        }

        .vlan-row-label {
            color: #94a3b8;
            font-weight: 700;
        }

        .vlan-row-value {
            color: #f1f5f9;
            font-weight: 700;
        }

        .vlan-row-value:hover {
            color: #60a5fa;
        }

        .vlan-row-value:active {
            color: #10b981;
        }

        .vlan-row-separator {
            color: #475569;
            font-weight: 300;
        }

        .dhcp-options-badge {
            background: rgba(59, 130, 246, 0.2);
            padding: 4px 8px;
            border-radius: 6px;
            border: 1px solid rgba(59, 130, 246, 0.4);
            cursor: help;
            transition: all 0.2s ease;
        }

        .dhcp-options-badge:hover {
            background: rgba(59, 130, 246, 0.3);
            border-color: rgba(59, 130, 246, 0.6);
            transform: scale(1.05);
        }

        /* ===== EMPTY STATE ===== */
        .empty-state {
            text-align: center;
            padding: 60px 24px;
            color: #64748b;
            font-size: 14px;
            font-weight: 600;
            opacity: 0.8;
        }

        /* ===== SPINNER ===== */
        .spinner {
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-top-color: white;
            border-radius: 50%;
            animation: spin 0.6s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* ===== HAMBURGER MENU ===== */
        .hamburger-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 48px;
            height: 48px;
            background: rgba(59, 130, 246, 0.15);
            border: 1px solid rgba(59, 130, 246, 0.3);
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
            z-index: 1001;
        }

        .hamburger-btn:hover {
            background: rgba(59, 130, 246, 0.25);
            border-color: rgba(59, 130, 246, 0.5);
            transform: scale(1.05);
        }

        .hamburger-btn.active {
            background: rgba(239, 68, 68, 0.2);
            border-color: rgba(239, 68, 68, 0.5);
        }

        .hamburger-icon {
            width: 24px;
            height: 24px;
            display: flex;
            flex-direction: column;
            justify-content: space-around;
            align-items: center;
        }

        .hamburger-icon span {
            display: block;
            width: 20px;
            height: 2px;
            background: #60a5fa;
            border-radius: 2px;
            transition: all 0.3s ease;
        }

        .hamburger-btn.active .hamburger-icon span {
            background: #ef4444;
        }

        .hamburger-btn.active .hamburger-icon span:nth-child(1) {
            transform: translateY(6px) rotate(45deg);
        }

        .hamburger-btn.active .hamburger-icon span:nth-child(2) {
            opacity: 0;
        }

        .hamburger-btn.active .hamburger-icon span:nth-child(3) {
            transform: translateY(-6px) rotate(-45deg);
        }

        /* ===== SLIDE-OUT NAVIGATION MENU ===== */
        .nav-menu {
            position: fixed;
            top: 0;
            right: -400px;
            width: 380px;
            height: 100vh;
            background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
            border-left: 1px solid rgba(59, 130, 246, 0.3);
            box-shadow: -8px 0 32px rgba(0, 0, 0, 0.5);
            transition: right 0.4s cubic-bezier(0.68, -0.55, 0.27, 1.55);
            z-index: 1000;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }

        .nav-menu.active {
            right: 0;
        }

        .nav-menu-header {
            padding: 32px 24px;
            border-bottom: 1px solid rgba(148, 163, 184, 0.2);
