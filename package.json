{
  "name": "ultimate-network-tool",
  "version": "1.0.0",
  "description": "Ultimate Network Tool - Network diagnostics with LLDP/CDP discovery, VLAN probing, MTU testing, and ping monitoring",
  "main": "electron/main.js",
  "author": "Digidots",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:python": "pyinstaller app.spec --noconfirm",
    "build:electron": "electron-builder",
    "build": "npm run build:python && npm run build:electron",
    "build:win": "npm run build:python && electron-builder --win",
    "pack": "electron-builder --dir",
    "dist": "npm run build"
  },
  "build": {
    "appId": "com.digidots.ultimate-network-tool",
    "productName": "Ultimate Network Tool",
    "copyright": "Copyright © 2025 Digidots",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ultimate Network Tool",
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "files": [
      "electron/**/*",
      "dist/app/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/app",
        "to": "app",
        "filter": ["**/*"]
      }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Digidots",
        "repo": "ultimate-network-tool",
        "private": false
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
